<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the durable nightly schedule. `install-nightly.sh` substitutes __ROOT__,
  __HOME__, __CLAUDE__ and __CLAUDE_DIR__ from the checkout it is run in, so nothing here is
  tied to one machine or one user.

  Not installed by default: loading it lets an agent edit this repository while nobody is
  watching, which is the user's call to make, not a side effect of cloning.
  `scripts/improve/night.py` holds the rules it runs under.

    scripts/improve/install-nightly.sh          # fills this in and loads it
    scripts/improve/install-nightly.sh --remove  # unloads and deletes it

  Modelled on com.tasc.autofix.plist, which already exists on this machine for another repo.
  A different Label, so the two never collide.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vibe.improve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/scripts/improve/night.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ROOT__</string>

    <!-- 23:07, off the hour: every scheduler in the world fires at :00. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>7</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/VibeImprove/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/VibeImprove/launchd-stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>

    <!-- One run per hour at most, however the calendar fires. -->
    <key>ThrottleInterval</key>
    <integer>3600</integer>

    <!-- Kill the claude and cargo children when the job stops. -->
    <key>AbandonProcessGroup</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__CLAUDE_DIR__</string>
        <key>VIBE_IMPROVE_ROOT</key>
        <string>__ROOT__</string>
        <key>VIBE_IMPROVE_CLAUDE</key>
        <string>__CLAUDE__</string>
    </dict>
</dict>
</plist>
